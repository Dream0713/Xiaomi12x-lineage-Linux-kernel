# Force kallsyms for KernelPatch / FolkPatch.
# kptools needs the kallsyms token table in the raw arm64 Image.
# In 4.19, CONFIG_KALLSYMS_ALL is only visible when DEBUG_KERNEL is enabled.
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KALLSYMS_BASE_RELATIVE=y

# LTO can reorder/merge symbols and makes the kallsyms parser less reliable.
# The stock LOS 4.19.246 kernel was built with LTO_NONE as well.
# CONFIG_LTO_CLANG is not set
CONFIG_LTO_NONE=y
# CFI_CLANG and SHADOW_CALL_STACK are tied to the LTO toolchain; disable them
# so the kernel is built like the non-LTO LOS kernel.
# CONFIG_CFI_CLANG is not set
# CONFIG_SHADOW_CALL_STACK is not set

# KernelSU and KernelPatch/FolkPatch both hook the kernel; do not mix them.
# CONFIG_KSU is not set

# Do not need debug info in the boot Image; make the build smaller/faster.
# CONFIG_DEBUG_INFO is not set
